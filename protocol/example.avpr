{
  "protocol": "ExampleService",
  "namespace": "example",

  "types": [
    {
      "type": "record",
      "name": "EchoRequest",
      "namespace": "example",
      "fields": [
        {
          "name": "message",
          "type": "string"
        }
      ]
    },
    {
      "type": "record",
      "name": "EchoResponse",
      "namespace": "example",
      "fields": [
        {
          "name": "message",
          "type": "string"
        }
      ]
    },
    {
      "type": "record",
      "name": "AddRequest",
      "namespace": "example",
      "fields": [
        {
          "name": "a",
          "type": "long"
        },
        {
          "name": "b",
          "type": "long"
        }
      ]
    },
    {
      "type": "record",
      "name": "AddResponse",
      "namespace": "example",
      "fields": [
        {
          "name": "result",
          "type": "long"
        }
      ]
    }
  ],

  "messages": {
    "echo": {
      "request": [
        {
          "name": "request",
          "type": "example.EchoRequest"
        }
      ],
      "response": "example.EchoResponse"
    },

    "add": {
      "request": [
        {
          "name": "request",
          "type": "example.AddRequest"
        }
      ],
      "response": "example.AddResponse"
    }
  }
}
